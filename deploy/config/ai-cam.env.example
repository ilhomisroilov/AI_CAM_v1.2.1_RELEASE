AI_CAM_PROJECT_ROOT=/opt/ai-cam
AI_CAM_DATA_ROOT=/var/lib/ai-cam
AI_CAM_LOG_ROOT=/var/log/ai-cam
AI_CAM_CONFIG=/etc/ai-cam/settings.production.yaml
AI_CAM_CAMERA_PASSWORD=
AI_CAM_ADMIN_PASSWORD=
AI_CAM_RFID_USERNAME=
AI_CAM_RFID_PASSWORD=
AI_CAM_AUTH_USERNAME=admin
AI_CAM_AUTH_OPERATOR_USERNAME=
AI_CAM_AUTH_OPERATOR_PASSWORD=
AI_CAM_ALLOW_CPU_FALLBACK=1
AI_CAM_OCR_USE_GPU=1
AI_CAM_FILE_LOGGING=0
PADDLE_HOME=/var/lib/ai-cam/temp/paddle
PADDLEOCR_HOME=/var/lib/ai-cam/temp/paddleocr
PYTHONUNBUFFERED=1
TZ=Asia/Tashkent
