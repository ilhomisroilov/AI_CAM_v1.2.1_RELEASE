# Copy only into your deployment secret manager/environment; do not commit .env.
AI_CAM_CAMERA_PASSWORD=
AI_CAM_RFID_USERNAME=
AI_CAM_RFID_PASSWORD=
AI_CAM_AUTH_USERNAME=admin
AI_CAM_ADMIN_PASSWORD=replace-with-a-strong-random-password
# Backward-compatible alias; leave unset when AI_CAM_ADMIN_PASSWORD is used.
# AI_CAM_AUTH_PASSWORD=
AI_CAM_AUTH_OPERATOR_USERNAME=
AI_CAM_AUTH_OPERATOR_PASSWORD=

# Ubuntu production roots/configuration.
AI_CAM_PROJECT_ROOT=/opt/ai-cam
AI_CAM_DATA_ROOT=/var/lib/ai-cam
AI_CAM_LOG_ROOT=/var/log/ai-cam
AI_CAM_CONFIG=/etc/ai-cam/settings.production.yaml
PYTHONUNBUFFERED=1
TZ=Asia/Tashkent

# Optional operational overrides.
AI_CAM_CROP_RETENTION_MAX=5000
AI_CAM_ALLOW_CPU_FALLBACK=0
AI_CAM_OCR_USE_GPU=1
AI_CAM_FILE_LOGGING=1
